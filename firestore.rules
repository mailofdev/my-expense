rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower() == 'admin';
    }

    // Users may keep their role, or receive "user" the first time the field is set.
    // Promoting to admin is done in the Firebase console, not from the app.
    function roleUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        || (
          !resource.data.keys().hasAny(['role'])
          && request.resource.data.get('role', 'user') == 'user'
        );
    }

    // User profile document: users/{userId}
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.role == 'user';
      allow update: if isSelf(userId) && roleUnchanged();
      allow delete: if isSelf(userId);

      // Subcollection: users/{userId}/expenses/{expenseId}
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: users/{userId}/walletTransactions/{txId}
      match /walletTransactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is denied by default (no catch-all needed)
  }
}
