rules_version = '2';

// Glow Money security model
//
// Collections in use:
//   users/{userId}                              profile, settings, repeats, accounts
//   users/{userId}/expenses/{expenseId}         spend rows, owner only
//   users/{userId}/walletTransactions/{txId}    income and transfers, owner only
//
// A signed-in user can read and write only their own profile and subcollections.
// An admin (users/{uid}.role == "admin") can read user profiles for the directory.
// Admins cannot read or write another person's expenses or wallet transactions.
// Clients cannot promote a profile to admin. Set role in the Firebase console.
// Anything not listed here is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower() == 'admin';
    }

    // Users may keep their role, or receive "user" the first time the field is set.
    // Promoting to admin is done in the Firebase console, not from the app.
    function roleUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        || (
          !resource.data.keys().hasAny(['role'])
          && request.resource.data.get('role', 'user') == 'user'
        );
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.role == 'user';
      allow update: if isSelf(userId) && roleUnchanged();
      allow delete: if isSelf(userId);

      match /expenses/{expenseId} {
        allow read, write: if isSelf(userId);
      }

      match /walletTransactions/{txId} {
        allow read, write: if isSelf(userId);
      }
    }
  }
}
